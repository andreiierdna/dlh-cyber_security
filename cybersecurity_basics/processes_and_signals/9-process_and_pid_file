#!/usr/bin/env bash
# Creates a PID file, loops forever, and handles SIGTERM, SIGINT, and SIGQUIT

echo $$ > /tmp/myscript.pid

clean_up() {
    rm -f /tmp/myscript.pid
    exit 0
}

trap 'echo "I hate the kill command"; clean_up' SIGTERM
trap 'echo "Y U no love me?!"' SIGINT
trap 'clean_up' SIGQUIT

while true
do
    echo "To infinity and beyond"
    sleep 2
done
